{
  "name": "neuro-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Neuro Lab — песочница спайковых нейронных сетей: нейроны, спайки, STDP, волны активности",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config vitest.bench.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "showcase": "node scripts/showcase.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
